# Invoicyfy web app on Apache / LiteSpeed (Hostinger).
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Always use HTTPS.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Khanak SaaS: public links of a shop (bills, pictures) are /t/<shop code>/api/... — served by the same API,
    # which reads the shop from KHANAK_TENANT. (Not used by a single-shop install.)
    RewriteRule ^t/([a-z0-9-]{3,30})/api/(.*)$ api/$2 [E=KHANAK_TENANT:$1,L,QSA]

    # The API lives in /api and handles its own requests.
    RewriteRule ^api(/|$) - [L]

    # Single-page app: every other unknown path loads index.html (e.g. /invoices/12 after a refresh).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# index.html must never be cached (so new versions load); hashed assets can be cached for a year.
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # The offline helper must be checked for updates on every visit.
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
